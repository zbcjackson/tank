      "id": "profile-name",
      "family": "profile-name",
      "kind": "complete",
      "rule_only": true,
      "rationale": "Exact textbox/button labels and supplied value; rules must fill and save without a model.",
      "html": "<!doctype html><meta charset=\"utf-8\"><script>window.events=[];</script><label>显示名称<input oninput=\"window.events.push('填写名称')\"></label><button onclick=\"window.events.push('保存');document.querySelector('[aria-label=Result]').textContent='saved:'+document.querySelector('input').value\">保存</button><output aria-label=\"Result\">idle</output>",
      "goal": {
        "schema_version": 1,
        "objective": "将显示名称设为 Ada 并保存。",
        "scope": "strategy",
        "inputs": [
          {
            "key": "name",
            "value": "Ada"
          }
        ],
        "milestones": [
          {
            "id": "fill",
            "operation": "fill",
            "role": "textbox",
            "label": "显示名称",
            "input_key": "name",
            "postcondition": {
              "key": "textbox:显示名称",
              "value": "Ada"
            }
          },
          {
            "id": "save",
            "operation": "click",
            "role": "button",
            "label": "保存",
            "postcondition": {
              "key": "status:Result",
              "value": "saved:Ada"
            }
          }
        ],
        "completion": [
          {
            "key": "status:Result",
            "value": "saved:Ada"
          }
        ]
      },
      "expected": {
        "events": [
          "填写名称",
          "保存"
        ],
        "result": "saved:Ada"
      }
    },
